# Copy to .env.local and fill in. .env* is gitignored (except this file).

# --- Gemini ---------------------------------------------------------------
# Used for BOTH chat generation and embeddings.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."

# --- Supabase (vector store) ----------------------------------------------
# Project URL and the publishable key. These two are all the running app needs:
# it only ever READS the corpus, and Row Level Security allows exactly that.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Write access, needed ONLY by `pnpm ingest`. Never set this in Vercel —
# the deployed app has no reason to hold a credential that can write.
# Supabase dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=""

# --- Tuning (optional) ----------------------------------------------------
# Cosine similarity below which a retrieval hit is treated as "no real match",
# so the assistant declines instead of forcing an irrelevant question.
# Embeddings are anisotropic — unrelated text still scores well above zero — so
# measure this against the real corpus rather than guessing.
RELEVANCE_FLOOR="0.55"
